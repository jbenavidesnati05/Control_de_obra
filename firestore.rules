rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario autenticado con Google tiene su propio espacio aislado:
    // solo el dueño de la cuenta (uid) puede leer o escribir sus tareas.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cualquier otra colección/documento queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
